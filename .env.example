# RSVP Radio / TV
TZ=America/Kentucky/Louisville
PORT=3000
POLL_MS=2000
POLL_TIMEOUT_MS=2500
SESSION_HEARTBEAT_PERSIST_MS=300000
PLEX_BASE=http://127.0.0.1:32400
PLEX_TOKEN=replace_with_plex_token
PLEX_TARGET_CLIENT_IDENTIFIER=replace_with_plexamp_client_id
MEDIA_DIR=/mnt/music
LIGHTS_URL=http://127.0.0.1:5005

# Local audio analyzer -> RSVP /features -> Hue reactive brightness
ANALYZER_SERVER_URL=http://127.0.0.1:3000/features
# Optional exact/substring PulseAudio/PipeWire monitor source. Leave blank to
# follow the current default sink's .monitor source automatically.
ANALYZER_SOURCE=
ANALYZER_SAMPLE_RATE=48000
ANALYZER_CHUNK_FRAMES=4096
ANALYZER_CHANNELS=2
ANALYZER_POST_INTERVAL_SECONDS=0.25
ANALYZER_STATUS_LOG_INTERVAL_SECONDS=10
FEATURES_STALE_MS=5000
FEATURES_DECAY_MS=12000
FEATURE_SIGNAL_RELAY_MS=2000

# Plex time-block playlist ratingKeys
PLAYLIST_LOFI=
PLAYLIST_LOUNGE=
PLAYLIST_RAP=
PLAYLIST_RNB=

# Optional sibling lanes
LANES_LOFI=
LANES_LOUNGE=
LANES_RAP=
LANES_RNB=
LANE_NAME_LOFI=
LANE_NAME_LOUNGE=
LANE_NAME_RAP=
LANE_NAME_RNB=

# Philips Hue local adapter
# Credentials/resource IDs are deliberately local configuration, not source code.
HUE_BRIDGE_HOST=replace_with_hue_bridge_ip
# Certificate Common Name / Hue Bridge ID (hex), used for TLS identity validation.
HUE_BRIDGE_ID=replace_with_bridge_id
HUE_USERNAME=replace_with_hue_authorized_username
# Numeric Hue group/zone ID from this bridge.
HUE_GROUP_ID=
HUE_SCENE_LOFI=replace_with_scene_id
HUE_SCENE_LOUNGE=replace_with_scene_id
HUE_SCENE_RAP=replace_with_scene_id
HUE_SCENE_RNB=replace_with_scene_id
HUE_ADAPTER_BIND=127.0.0.1
HUE_ADAPTER_PORT=5005
HUE_REQUEST_TIMEOUT_MS=2500
HUE_MODE_TRANSITION_MS=800
# Subtle music-reactive brightness. Color remains owned by the active RSVP scene.
HUE_REACTIVE_ENABLED=true
HUE_REACTIVE_RANGE=36
HUE_REACTIVE_MIN_INTERVAL_MS=1800
HUE_REACTIVE_TRANSITION_MS=1200
# Optional PEM bundle for bridge TLS validation if not already trusted by the Pi.
HUE_CA_CERT_PATH=

# Optional admin / integrations
EXIT_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_TIMEOUT_MS=3000
# Needed only when Plex webhooks originate from another machine.
# Configure that webhook URL as http://<pi>:3000/plex?token=<this-value>
PLEX_WEBHOOK_TOKEN=
