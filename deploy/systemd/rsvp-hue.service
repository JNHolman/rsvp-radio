[Unit]
Description=RSVP Philips Hue Adapter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/rsvp-radio
EnvironmentFile=/home/pi/rsvp-radio/.env
ExecStart=/usr/bin/node /home/pi/rsvp-radio/hue-adapter.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
